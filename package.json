{
  "name": "loupe",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": ["packages/*"],
  "scripts": {
    "format": "oxfmt --check \"**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}\"",
    "format:fix": "oxfmt --write \"**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}\"",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "tsc": "./node_modules/typescript-7/bin/tsc --build",
    "test": "vitest run",
    "check": "bun format && bun lint && bun tsc && bun test"
  },
  "dependencies": {
    "@octokit/rest": "22.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "bun-types": "1.3.14",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "oxlint-tsgolint": "0.24.0",
    "typescript-7": "npm:typescript@7.0.2",
    "vitest": "4.1.10"
  }
}

{
  "harness": "whip",
  "model": "kimi-k3",
  "timezone": "PST",
  "dir": "inference",
  "whip": {
    "provider": {
      "name": "inference-net",
      "label": "Inference.net",
      "baseUrl": "https://api.inference.net/v1",
      "apiKeyEnv": "INFERENCE_API_KEY"
    },
    "defaultModel": "kimi-k3",
    "models": [
      "kimi-k3",
      "kimi-k3-fast",
      "glm-5.3-flash",
      "glm-5.2-fast",
      "deepseek-v4-pro-0813",
      "gpt-5.6-luna"
    ]
  },
  "reviewers": [
    {
      "name": "bugs",
      "promptFile": "reviewers/bugs.md",
      "include": ["**/*.ts", "**/*.tsx"],
      "exclude": ["**/*.test.ts", "**/tests/**"],
      "reasoning": "medium"
    },
    {
      "name": "migrations",
      "promptFile": "reviewers/migrations.md",
      "include": [
        "**/migrations/**/*.sql",
        "**/migrations/**/migration.ts",
        "**/migrations/**/*.up.sql"
      ],
      "reasoning": "high"
    }
  ]
}
